/* 铁幕:前线 · UI 主题 v1(2026-09-11 demo→成品迁移第 0 步)
 * 纯 USS 代码主题,先成形后换肤;集中在此,换皮=换这份文件。
 * 色板:深石板底 + 冰蓝阵营强调(与蓝方屏障色系一致)。 */

:root {
    --accent: rgb(88, 166, 255);
    --panel-bg: rgba(16, 20, 28, 0.92);
    --panel-border: rgba(120, 140, 170, 0.55);
    --text: rgb(232, 238, 246);
    --text-dim: rgba(232, 238, 246, 0.62);
}

.panel {
    /* 2026-09-13 制作人:UI 皮肤(木框白底九宫格)在 UITK 迁移时漏接,现接回。
       木框白底 = 浅底 → 面板内文字统一转深色(见下方 .panel 文本规则),否则浅字白底不可读。 */
    background-image: resource("UI/panel_wood");
    -unity-slice-left: 82;
    -unity-slice-right: 82;
    -unity-slice-top: 82;
    -unity-slice-bottom: 82;
    -unity-slice-scale: 0.55;
    padding: 10px;
}
.panel .label { color: rgb(46, 38, 30); }
.panel .label-dim { color: rgba(46, 38, 30, 0.72); }
.panel .label-title { color: rgb(38, 30, 24); }
.panel .label-clock, .panel .label-clock-overtime, .panel .label-phase { color: rgb(38, 30, 24); }
.panel .bp-card-name, .panel .bp-group-tag { color: rgb(38, 30, 24); -unity-text-outline: 0 rgb(0,0,0); }
.panel .feedback-ok { color: rgb(24, 96, 40); }
.panel .feedback-err { color: rgb(150, 30, 24); }

.topbar {
    background-color: rgba(8, 10, 14, 0.66);
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 140, 170, 0.35);
}

.label { color: var(--text); }
.label-dim { color: var(--text-dim); }
.label-title { font-size: 18px; color: rgb(255, 255, 255); }
.label-clock { font-size: 21px; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.label-clock-overtime { font-size: 21px; color: rgb(255, 140, 51); -unity-text-align: middle-center; }
.label-phase { font-size: 12px; color: rgba(232, 238, 246, 0.7); -unity-text-align: middle-center; }
.feedback-ok { color: rgb(126, 224, 138); }
.feedback-err { color: rgb(255, 122, 110); }

.btn {
    /* 2026-09-13 接回木底按钮皮肤(九宫格) */
    background-image: resource("UI/button_wood");
    -unity-slice-left: 60;
    -unity-slice-right: 60;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.5;
    color: rgb(255, 248, 236);
    padding: 4px 10px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.08s;
}
.btn:hover { color: rgb(255, 238, 206); scale: 1.02; }
.btn:active { color: rgb(255, 226, 170); scale: 0.97; }
.btn:disabled { opacity: 0.4; }
.btn-accent {
    background-color: rgb(35, 80, 130);
    border-color: rgb(88, 166, 255);
}

.hpbar-shell {
    height: 14px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    overflow: hidden;
}
.hpbar-fill { height: 100%; border-radius: 2px; }

.row { flex-direction: row; align-items: center; }
.gap { margin-left: 8px; }
.grow { flex-grow: 1; }

.map-frame {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
}

.marker {
    color: rgb(255, 230, 128);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.victory-title {
    font-size: 76px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 220, 120);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
}
.tooltip-bg {
    background-color: rgba(10, 13, 18, 0.88);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(140, 160, 190, 0.5);
    padding: 4px 8px;
}

/* ===== BP 选将页(2026-09-13,DeepSeek 视觉审查指令) ===== */
.bp-pill {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 26px;
    color: rgb(255, 217, 102);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.bp-card {
    background-color: rgba(30, 42, 68, 0.90);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
}
.bp-card-name {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline: 1px rgb(0, 0, 0);
    -unity-text-align: middle-center;
}
.bp-namebar { background-color: rgba(11, 18, 32, 0.95); border-radius: 6px; height: 32px; }
.bp-group-tag {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline: 1px rgb(0, 0, 0);
}
.bp-group-line { background-color: rgb(59, 130, 246); height: 2px; width: 156px; }
.bp-slot {
    background-color: rgba(26, 31, 46, 0.70);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(58, 74, 107);
}
.bp-done {
    font-size: 32px;
    color: rgb(255, 217, 102);
    -unity-font-style: bold;
    -unity-text-outline: 1px rgb(0, 0, 0);
}
